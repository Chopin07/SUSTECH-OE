\PYG{+w}{        }\PYG{l+s}{\PYGZsq{}String\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nb}{sprintf}\PYG{p}{(}\PYG{l+s}{\PYGZsq{}m = \PYGZpc{}.3f kg, q = \PYGZpc{}.4f C, |B| = \PYGZpc{}.1f T, dt = \PYGZpc{}.4f s, sample final speed = \PYGZpc{}.4f m/s, sample final radius = \PYGZpc{}.4f m\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{...}
\PYG{+w}{        }\PYG{n}{m}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{q}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nb}{norm}\PYG{p}{(}\PYG{n}{B}\PYG{p}{),}\PYG{+w}{ }\PYG{n}{dt}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{final\PYGZus{}speed}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{final\PYGZus{}radius}\PYG{p}{),}\PYG{+w}{ }\PYG{k}{...}
\PYG{+w}{        }\PYG{l+s}{\PYGZsq{}HorizontalAlignment\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s}{\PYGZsq{}center\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s}{\PYGZsq{}EdgeColor\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s}{\PYGZsq{}none\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s}{\PYGZsq{}FontSize\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{10}\PYG{p}{);}

\PYG{+w}{    }\PYG{c}{\PYGZpc{} 将当前图保存到 figures 文件夹中}
\PYG{+w}{    }\PYG{n+nb}{exportgraphics}\PYG{p}{(}\PYG{n}{fig}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nb}{fullfile}\PYG{p}{(}\PYG{n}{output\PYGZus{}dir}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nb}{sprintf}\PYG{p}{(}\PYG{l+s}{\PYGZsq{}magnetic\PYGZus{}focusing\PYGZus{}t\PYGZpc{}g.png\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{t\PYGZus{}end}\PYG{p}{)),}\PYG{+w}{ }\PYG{l+s}{\PYGZsq{}Resolution\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{220}\PYG{p}{);}
\PYG{+w}{    }\PYG{n+nb}{close}\PYG{p}{(}\PYG{n}{fig}\PYG{p}{);}
\PYG{k}{end}

\PYG{n+nb}{fprintf}\PYG{p}{(}\PYG{l+s}{\PYGZsq{}Finished generating figures in \PYGZpc{}s\PYGZbs{}n\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{output\PYGZus{}dir}\PYG{p}{);}

\PYG{c}{\PYGZpc{} =========================}
\PYG{c}{\PYGZpc{} 子函数：用显式欧拉法求解单个粒子的运动过程}
\PYG{c}{\PYGZpc{} 输入：}
\PYG{c}{\PYGZpc{}   m, q : 粒子质量和电荷量}
\PYG{c}{\PYGZpc{}   E, B : 电场和磁场矢量}
\PYG{c}{\PYGZpc{}   dt   : 时间步长}
\PYG{c}{\PYGZpc{}   t    : 时间数组}
\PYG{c}{\PYGZpc{}   v0   : 初速度}
\PYG{c}{\PYGZpc{} 输出：}
\PYG{c}{\PYGZpc{}   r    : 每个时刻的位置矢量}
\PYG{c}{\PYGZpc{}   v    : 每个时刻的速度矢量}
\PYG{c}{\PYGZpc{} =========================}
\PYG{k}{function}\PYG{+w}{ }\PYG{n+nf}{[r, v] = simulate\PYGZus{}particle}\PYG{p}{(}m, q, E, B, dt, t, v0\PYG{p}{)}
\PYG{n}{num\PYGZus{}steps}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n+nb}{numel}\PYG{p}{(}\PYG{n}{t}\PYG{p}{);}
\PYG{n}{r}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n+nb}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}steps}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{3}\PYG{p}{);}\PYG{+w}{  }\PYG{c}{\PYGZpc{} 位置数组，三列分别对应 x、y、z}
\PYG{n}{v}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n+nb}{zeros}\PYG{p}{(}\PYG{n}{num\PYGZus{}steps}\PYG{p}{,}\PYG{+w}{ }\PYG{l+m+mi}{3}\PYG{p}{);}\PYG{+w}{  }\PYG{c}{\PYGZpc{} 速度数组，三列分别对应 x、y、z}
\PYG{n}{v}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n}{v0}\PYG{p}{;}\PYG{+w}{             }\PYG{c}{\PYGZpc{} 设置初始速度}

\PYG{k}{for}\PYG{+w}{ }\PYG{n+nb}{i}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{:(}\PYG{n}{num\PYGZus{}steps}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}
\PYG{+w}{    }\PYG{c}{\PYGZpc{} 计算洛伦兹力：F = qE + q(v × B)}
\PYG{+w}{    }\PYG{n}{force}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n}{q}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{E}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{q}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n+nb}{cross}\PYG{p}{(}\PYG{n}{v}\PYG{p}{(}\PYG{n+nb}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:),}\PYG{+w}{ }\PYG{n}{B}\PYG{p}{);}

\PYG{+w}{    }\PYG{c}{\PYGZpc{} 根据牛顿第二定律求加速度：a = F / m}
\PYG{+w}{    }\PYG{n}{accel}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n}{force}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n}{m}\PYG{p}{;}

\PYG{+w}{    }\PYG{c}{\PYGZpc{} 显式欧拉法更新下一时刻速度}
\PYG{+w}{    }\PYG{n}{v}\PYG{p}{(}\PYG{n+nb}{i}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n}{v}\PYG{p}{(}\PYG{n+nb}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{accel}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{dt}\PYG{p}{;}

\PYG{+w}{    }\PYG{c}{\PYGZpc{} 显式欧拉法更新下一时刻位置}
\PYG{+w}{    }\PYG{n}{r}\PYG{p}{(}\PYG{n+nb}{i}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{p}{=}\PYG{+w}{ }\PYG{n}{r}\PYG{p}{(}\PYG{n+nb}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{v}\PYG{p}{(}\PYG{n+nb}{i}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{:)}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{dt}\PYG{p}{;}
\PYG{k}{end}
\PYG{k}{end}
\end{MintedVerbatim}
